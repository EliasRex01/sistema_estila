# --- Desarrollo local (SQLite, sin VPD) ---
DATABASE_URL=sqlite:///./estila.db
JWT_SECRET=changeme-jwt-estila-cambiar-en-prod-32-plus
JWT_EXPIRE_MIN=480
MASTER_KEY=changeme-master-estila

# --- Oracle con wallet/mTLS (VM produccion o PC) ---
# 1) Descargar wallet.zip de la consola ADB a ./wallet y descomprimir.
# 2) TNS_ADMIN=./wallet  (ruta con tnsnames.ora, sqlnet.ora, ewallet.pem)
# 3) Usar el alias del servicio (ver tnsnames.ora, ej. estila_high).
# DATABASE_URL=oracle+oracledb://ESTILA_APP:TuClave123#@estila_high
# (Si la clave tiene # / @ / %, codificarla: # -> %23, @ -> %40, % -> %25)

# --- Oracle con TLS sin wallet (Vercel/pruebas; desactivar mTLS en consola ADB) ---
# ORACLE_USER=ESTILA_APP
# ORACLE_PASSWORD=TuClave123#
# ORACLE_DSN=(DESCRIPTION=(ADDRESS=(PROTOCOL=TCPS)(HOST=adb.xx.oraclecloud.com)(PORT=1522))(CONNECT_DATA=(SERVICE_NAME=xx_estila_high.adb.oraclecloud.com))(SECURITY=(SSL_SERVER_DN_MATCH=no)))

# --- Oracle local con Docker (ver docker-compose.yml) ---
# DATABASE_URL=oracle+oracledb://system:EstilaLocal123@db:1521/FREEPDB1
